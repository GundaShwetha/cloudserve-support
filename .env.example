# Copy to .env and fill in your own values.
#   macOS/Linux:  cp .env.example .env        Windows:  copy .env.example .env
# .env is git-ignored. Never commit a real key.

# ---------------- model provider (optional) ----------------
# Without a key the system still runs end to end: replies are built extractively from the documentation.
# LLM_PROVIDER: openrouter or groq
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_key_here
GROQ_API_KEY=
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
# GENERATION_MODE: auto (use the model when a key is set) | llm | extractive
GENERATION_MODE=auto
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=3
# Client-side throttle that keeps runs inside the free tier
LLM_REQUESTS_PER_MINUTE=18

# ---------------- retrieval ----------------
# RETRIEVAL_BACKEND: auto (Chroma + all-MiniLM-L6-v2, falls back to tfidf) | chroma | tfidf
RETRIEVAL_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5

# ---------------- storage (created at runtime, git-ignored) ----------------
CHROMA_PATH=./storage/chroma
DECISION_DB=./storage/decisions.db

# ---------------- behaviour ----------------
# Set to false to stop all automatic replies (kill switch by configuration)
AUTO_RESPOND_ENABLED=true
# Leave CONFIDENCE_THRESHOLD unset: thresholds come from config/thresholds.json, chosen from data.
# CONFIDENCE_THRESHOLD=
ADMIN_TOKEN=change_me
LOG_LEVEL=INFO

{
  "uid": "cloudserve-support",
  "title": "CloudServe support system",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tickets processed per hour, by channel and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, outcome) (increase(tickets_processed_total[1h]))",
          "legendFormat": "{{channel}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Answered automatically vs escalated",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tickets_processed_total{outcome=\"answered\"}[15m])) / sum(rate(tickets_processed_total[15m]))",
          "legendFormat": "answered share"
        },
        {
          "refId": "B",
          "expr": "sum(rate(tickets_processed_total{outcome=~\"escalated|blocked_escalated|error_escalated\"}[15m])) / sum(rate(tickets_processed_total[15m]))",
          "legendFormat": "escalated share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Response latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(response_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(response_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Guardrail blocks by guardrail",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (guardrail) (increase(guardrail_blocks_total[1h]))",
          "legendFormat": "{{guardrail}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Routing confidence distribution (drift shows here first)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(route_confidence_bucket[1h]))",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Model provider failures (fell back to extractive)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(provider_failures_total[1h])",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Kill switch engaged",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kill_switch_engaged",
          "legendFormat": "engaged"
        }
      ]
    }
  ],
  "tags": [
    "capstone"
  ]
}